rules_version = '2';

// Point Detective — Firestore security rules
//
// `subscribers/{uid}` — subscription status. The user READS their own doc;
//   only the Lemon Squeezy webhook (Firebase Admin SDK, bypasses rules) WRITES it.
//   This is what stops a user from self-granting access.
//
// `matchData/{uid}` — the user's own match history, synced across their devices.
//   The user reads and writes only their own doc; nobody else can touch it.

service cloud.firestore {
  match /databases/{database}/documents {

    match /subscribers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /matchData/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
