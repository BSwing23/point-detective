rules_version = '2';

// Point Detective — Firestore security rules
//
// The only server-side collection is `subscribers`, keyed by Firebase Auth uid.
// - Each signed-in user may READ their own subscriber doc (to learn their status).
// - No client may WRITE it. Only the Lemon Squeezy webhook (Netlify function,
//   Firebase Admin SDK) writes subscription status — the Admin SDK bypasses these
//   rules. This is what stops a user from self-granting access.

service cloud.firestore {
  match /databases/{database}/documents {

    match /subscribers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
