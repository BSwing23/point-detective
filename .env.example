# Point Detective — serverless function environment variables
# Copy to .env for local `netlify dev`, and set the real values in the Netlify
# dashboard (Site configuration -> Environment variables) for production.

# The signing secret you enter when creating the webhook in Lemon Squeezy
# (Settings -> Webhooks). Any random string; must match exactly on both sides.
LEMONSQUEEZY_WEBHOOK_SECRET=

# The full Firebase service-account JSON, as a single line.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the entire file contents (with the \n newlines inside private_key left as-is).
FIREBASE_SERVICE_ACCOUNT=
